# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=storeApp

# Auth: generate with `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (e.g. 1 on Render/Heroku/behind Nginx)
TRUST_PROXY=0

# AWS S3 (private bucket for listing images)
AWS_REGION=eu-west-2
AWS_S3_BUCKET=your-bucket-name
# Optional: leave unset to use the default AWS credential chain (IAM role, ~/.aws profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
